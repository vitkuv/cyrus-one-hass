{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's/version = \".*\"/version = \"${nextRelease.version}\"/' pyproject.toml && sed -i 's/\"version\": \".*\"/\"version\": \"${nextRelease.version}\"/' custom_components/cyrus_one/manifest.json"
    }],
    ["@semantic-release/git", {
      "assets": ["pyproject.toml", "custom_components/cyrus_one/manifest.json", "CHANGELOG.md"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "cyrus_one.zip", "label": "Cyrus ONE HACS package"}
      ]
    }]
  ]
}
